DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resq_siren
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-dev-secret
HMAC_SECRET=change-me-dispatch-hmac-secret
MAPBOX_TOKEN=
OSRM_BASE_URL=https://router.project-osrm.org
# Comma-separated frontend origins allowed to call this API. Add the deployed
# frontend URL in production, e.g.
# CORS_ORIGINS=http://localhost:5173,https://resq-siren.vercel.app
CORS_ORIGINS=http://localhost:5173
# NOTE: legacy FCM server key API was decommissioned by Google in June 2024 —
# this is currently unusable regardless of value, see README.
FCM_SERVER_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional — used to generate the patient summary shown to the receiving
# hospital. Falls back to a deterministic template if unset.
GEMINI_API_KEY=
# Optional — emails the patient summary report to the assigned hospital's
# contact address whenever a dispatch is created or re-routed. Seeded demo
# hospitals use `.invalid` addresses (RFC 2606, guaranteed non-routable) so
# this can never accidentally deliver to a real hospital. No-ops if unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
